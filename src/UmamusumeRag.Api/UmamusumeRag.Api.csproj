<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Local development secrets (Llm:ApiKey) live outside the repo.
         Run inside src/UmamusumeRag.Api:  dotnet user-secrets set "Llm:ApiKey" "<token>" -->
    <UserSecretsId>dda2efb4-da11-441f-8957-24e97ec12773</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Required by the EF Core tools (dotnet ef) at design time. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UmamusumeRag.Core\UmamusumeRag.Core.csproj" />
    <ProjectReference Include="..\UmamusumeRag.Infrastructure\UmamusumeRag.Infrastructure.csproj" />
  </ItemGroup>

</Project>
